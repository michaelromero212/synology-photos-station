# Copy to .env beside docker-compose.yml on the NAS. Never commit .env.

# Postgres password. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Root of the DSM shared folder holding blobs, derivatives, and pgdata.
FRAMESTATION_ROOT=/volume1/framestation

# DSM sign-in. Leave as-is unless host-gateway is unsupported, in which case
# use the NAS's own LAN address, e.g. http://192.168.4.83:5000
FRAMESTATION_DSM_URL=http://host.docker.internal:5000

# Where DSM keeps user home directories.
FRAMESTATION_HOMES=/volume1/homes

# trace | debug | info | notice | warning | error | critical
LOG_LEVEL=info

# --- M6 (push notifications), not read yet ---
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=/run/secrets/apns.p8
# APNS_TOPIC=com.michaelromero.framestation
