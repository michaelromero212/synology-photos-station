# Secrets — Postgres password, APNs key id/team id
.env
Server/*.p8
*.p8

# The NAS's real public hostname and LAN address. DEPLOY.md carries the
# commands with <nas-host> / <nas-lan-ip> placeholders; this file is the only
# place the actual values live, and this repository is public.
DEPLOY.local.md

# Swift / SPM
.build/
.swiftpm/
Package.pins

# Xcode (project is XcodeGen-generated from project.yml)
*.xcodeproj/
*.xcworkspace/
DerivedData/
# xcodebuild run from the project directory writes here rather than to
# DerivedData. Nothing generated belongs in a public repo.
build/
xcuserdata/
*.xcuserdatad

# Generated icon output — regenerate with `swift Scripts/GenerateIcon.swift`.
# The asset catalogs under App/Resources are committed; this directory is just
# the intermediate render (and 5.5 MB of the repo if left in).
Design/Icon/

# macOS
.DS_Store

# Local dev artifacts
*.log
/tmp/

# Generated reverse-geocoding dataset — rebuild with Scripts/fetch-geonames.sh
Data/geonames/
